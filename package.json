{
  "name": "openpaths",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "prebuild": "npm run generate:app-og && npm run generate:sitemap",
    "generate:brand-assets": "python3 scripts/generate-logo-assets.py",
    "generate:og": "python3 scripts/gen_og.py && python3 scripts/gen_og_providers.py && python3 scripts/gen_og_sync_lipsync.py && npm run generate:app-og",
    "generate:app-og": "tsx scripts/generate-app-og.ts",
    "build": "vite build && tsx scripts/prerender-static-meta.ts",
    "generate:sitemap": "tsx scripts/generate-sitemap.ts",
    "crawl:artificial-analysis": "node crawlers/artificial_analysis.mjs --refresh",
    "crawl:artificial-analysis-images": "node crawlers/artificial_analysis_images.mjs --refresh",
    "art:migrate": "python3 scripts/migrate_zimage_art_index.py",
    "video:gallery:xai": "node scripts/generate_xai_video_gallery.mjs",
    "verify:assets": "node scripts/verify-stable-assets.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:e2e": "npx playwright test",
    "test:e2e:spaces": "npx playwright test e2e/spaces.spec.ts",
    "test:e2e:paid-models": "npx playwright test e2e/new-models-live.spec.ts --config=playwright.real.config.ts",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:live": "npx playwright test --config=playwright.live.config.ts"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@google/genai": "^1.29.0",
    "@stripe/react-stripe-js": "^5.6.1",
    "@stripe/stripe-js": "^8.8.0",
    "@tailwindcss/vite": "^4.1.14",
    "@uiw/react-codemirror": "^4.25.10",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
